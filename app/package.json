{
  "name": "@fume/app",
  "version": "0.1.0",
  "private": true,
  "description": "The Fume app: workspace, Quality Gate and Operations (PROPOSED, 14 Oct 2026). Front end on mock data; backend implements src/contract.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:preview": "tsc --noEmit && VITE_ROUTER=memory vite build --outDir dist-preview"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.1",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-query": "5.59.16",
    "@vercel/functions": "3.9.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
