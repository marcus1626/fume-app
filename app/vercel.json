{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "images": {
    "sizes": [2048],
    "qualities": [80],
    "formats": ["image/webp"],
    "minimumCacheTTL": 21600,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "vkusmctftfzsrxbcxtdz.supabase.co",
        "pathname": "^/storage/v1/object/sign/workspace-files/.*$"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/((?!api/|demo/|assets/|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/design.js": {
      "maxDuration": 90,
      "memory": 2048,
      "includeFiles": "node_modules/{canvaskit-wasm/bin,@open-pencil/core/assets}/**"
    },
    "api/shot.js": {
      "maxDuration": 90,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  }
}
